# Optional: auto uses Claude when its key is set, then OpenAI when its key is set.
# With neither key, Converge uses the built-in parser and engine-generated summaries.
# CONVERGE_LLM_PROVIDER=auto  # auto | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# CONVERGE_LLM_MODEL=claude-haiku-5-5
# CONVERGE_OPENAI_MODEL=gpt-6-luna

# Optional: location of the UBS challenge data (default: external/ubs/Data)
# CONVERGE_UBS_DATA_DIR=external/ubs/Data
# Optional: the two UBS profile ids paired as the demo couple (default: Nina and Emil)
# CONVERGE_PARTNERS=P00918,P00809

# Frontend -> backend proxy target (default: http://127.0.0.1:8000)
# CONVERGE_API_URL=http://127.0.0.1:8000

# Finance agent chat supports auto | local | openai | openrouter | off.
# Auto prefers a configured local model, then OpenAI, then OpenRouter.
# CONVERGE_AGENT_PROVIDER=auto
# CONVERGE_AGENT_MODEL=

# Voice defaults to Realtime when OPENAI_API_KEY is set, otherwise off.
# CONVERGE_VOICE_PROVIDER=openai_realtime
# CONVERGE_VOICE_MAX_SECONDS=300
# Optional local transport (see docs/VOICE.md for model setup).
# CONVERGE_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# CONVERGE_LOCAL_LLM_MODEL=
# CONVERGE_LOCAL_STT_MODEL=
# CONVERGE_LOCAL_TTS_MODEL=
